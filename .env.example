# ==============================================================================
# REFRIGERATOR EXPIRY NOTIFICATION PWA - ENVIRONMENT VARIABLES
# ==============================================================================
# 100% Free Tier Hybrid Architecture (Vercel + Firebase us-central1)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE CONFIGURATION (Web SDK - 100% Free Tier)
# ------------------------------------------------------------------------------
# IMPORTANT: Create your Firebase project and select region "us-central1" (nam5)
# to ensure permanent zero-cost Free Tier usage!
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# ------------------------------------------------------------------------------
# 2. WEB PUSH (VAPID) CONFIGURATION (100% Free - Native Web Push API)
# ------------------------------------------------------------------------------
# Generate your VAPID keys by running: npm run generate-vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BEl62iXXXXX_YOUR_PUBLIC_VAPID_KEY_HERE_XXXXX"
VAPID_PRIVATE_KEY="YOUR_PRIVATE_VAPID_KEY_HERE"
VAPID_SUBJECT="mailto:your-email@example.com"

# ------------------------------------------------------------------------------
# 3. VERCEL CRON SECURITY (Optional but Recommended)
# ------------------------------------------------------------------------------
# Secret token to authorize /api/cron/notify requests
CRON_SECRET="your_random_secret_string_here"

# ------------------------------------------------------------------------------
# 4. OPTIONAL: GEMINI FLASH API KEY (Free Tier from Google AI Studio)
# ------------------------------------------------------------------------------
# Optional: Client-side Tesseract.js OCR is used by default with zero cost.
# If provided, enables enhanced multi-modal AI scan fallback.
# GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
